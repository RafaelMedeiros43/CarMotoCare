APP_NAME="CarMotoCare MS Alerts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Stateless API: no sessions, file cache, jobs run inline.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# System APIs
SAPI_VEHICLES_URL=http://sapi-vehicles:8081

# MQTT broker (RabbitMQ, internal port)
MQTT_HOST=rabbitmq
MQTT_PORT=1883
MQTT_CLIENT_ID=ms-alerts
MQTT_USERNAME=
MQTT_PASSWORD=

# Alert thresholds
ALERT_KM_THRESHOLD=1000
ALERT_DAYS_AHEAD=30
