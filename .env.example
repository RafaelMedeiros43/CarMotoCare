# Variáveis comuns do projeto (usadas pelo docker-compose.yml quando existir).
# Copiar para .env e preencher. Nunca fazer commit do .env.
# Cada projeto Laravel tem também o seu próprio .env.example.

# Base de dados (PostgreSQL; em produção, Supabase)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=carmotocare
POSTGRES_USER=
POSTGRES_PASSWORD=

# Broker (RabbitMQ com o plugin MQTT)
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
MQTT_HOST=rabbitmq
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# Utilizadores MQTT internos (um por serviço)
MQTT_EAPI_USER=
MQTT_EAPI_PASSWORD=
MQTT_MS_OBD_USER=
MQTT_MS_OBD_PASSWORD=
MQTT_MS_ALERTS_USER=
MQTT_MS_ALERTS_PASSWORD=

# Autenticação (EAPI Web)
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Endereços internos das SAPIs (rede do Docker)
SAPI_USERS_URL=http://sapi-users:8082
SAPI_VEHICLES_URL=http://sapi-vehicles:8081
SAPI_WORKSHOPS_URL=http://sapi-workshops:8083

# Portas expostas
EAPI_PORT=8080
FRONTEND_PORT=5173
MS_OBD_PORT=8084
MS_ALERTS_PORT=8085

# Microserviço de alertas
ALERT_KM_THRESHOLD=1000
ALERT_DAYS_AHEAD=30


