# Variáveis comuns do projeto (usadas pelo docker-compose.yml).
# Copiar para .env e preencher. Nunca fazer commit do .env.
# Cada projeto Laravel tem também o seu próprio .env.example (o .env é criado no primeiro arranque).

# Porta do site no teu computador (http://localhost:<porta>). Mudar se a 80 estiver ocupada.
HTTP_PORT=80

# Autenticação (EAPI Web). OBRIGATÓRIO: sem o JWT_SECRET o login falha.
# Gerar um valor (mínimo 32 caracteres) com:  openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Base de dados (PostgreSQL, em container; na VM é igual).
# O utilizador e a palavra-passe só contam quando a base é criada (primeiro arranque).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=carmotocare
POSTGRES_USER=carmotocare
POSTGRES_PASSWORD=muda-isto

# Broker (RabbitMQ com o plugin MQTT)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=muda-isto
MQTT_HOST=rabbitmq
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# As variáveis daqui para baixo ainda não são usadas pelo docker-compose.yml.

# Utilizadores MQTT internos (um por serviço)
MQTT_EAPI_USER=
MQTT_EAPI_PASSWORD=
MQTT_MS_OBD_USER=
MQTT_MS_OBD_PASSWORD=
MQTT_MS_ALERTS_USER=
MQTT_MS_ALERTS_PASSWORD=

# Endereços internos das SAPIs (rede do Docker)
SAPI_USERS_URL=http://sapi-users:8082
SAPI_VEHICLES_URL=http://sapi-vehicles:8081
SAPI_WORKSHOPS_URL=http://sapi-workshops:8083

# Portas expostas
EAPI_PORT=8080
FRONTEND_PORT=5173
MS_OBD_PORT=8084
MS_ALERTS_PORT=8085

# Microserviço de alertas
ALERT_KM_THRESHOLD=1000
ALERT_DAYS_AHEAD=30
