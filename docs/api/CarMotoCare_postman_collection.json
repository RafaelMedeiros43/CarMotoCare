    {
      "name": "4. Simulador OBD → RabbitMQ (API de gestão)",
      "item": [
        {
          "name": "1) Criar fila de teste (201/204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('fila criada', () => pm.expect([201, 204]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbitMgmt}}/api/queues/%2F/obd-test",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durable\": true,\n  \"auto_delete\": false\n}"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2) Ligar a fila aos tópicos obd/telemetry/# (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('binding criado', () => pm.expect([201, 204]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
